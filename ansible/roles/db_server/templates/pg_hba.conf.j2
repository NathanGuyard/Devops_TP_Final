# PostgreSQL Client Authentication Configuration File
# TYPE  DATABASE        USER            ADDRESS                 METHOD

# Local connections
local   all             postgres                                peer
local   all             all                                     peer

# IPv4 local connections
host    all             all             127.0.0.1/32            scram-sha-256

# IPv6 local connections
host    all             all             ::1/128                 scram-sha-256

# Application connections
host    {{ db_name }}   {{ db_user }}   {{ app_servers[0].ip }}/32     scram-sha-256
host    {{ db_name }}   {{ db_user }}   {{ app_servers[1].ip }}/32     scram-sha-256

# Replication connections
host    replication     {{ replication_user }}  {{ db_slave_ip }}/32   scram-sha-256
host    replication     {{ replication_user }}  {{ db_master_ip }}/32  scram-sha-256
