# Configuration PostgreSQL Master pour Alpine Linux
# Optimisé pour 1GB RAM

# Connexions
listen_addresses = '*'
port = {{ db_port }}
max_connections = 50

# Mémoire (optimisé pour 1GB RAM)
shared_buffers = 256MB
effective_cache_size = 512MB
maintenance_work_mem = 64MB
work_mem = 16MB

# WAL et Réplication
wal_level = replica
max_wal_senders = 5
wal_keep_size = 256MB
synchronous_commit = on

# Archivage
archive_mode = on
archive_command = 'cp %p /var/lib/postgresql/wal_archive/%f'

# Checkpoints
checkpoint_completion_target = 0.9
max_wal_size = 512MB
min_wal_size = 128MB

# Logging
logging_collector = on
log_directory = '/var/log/postgresql'
log_filename = 'postgresql-%Y-%m-%d.log'
log_rotation_age = 1d
log_rotation_size = 50MB
log_min_duration_statement = 1000
log_checkpoints = on
log_connections = on
log_disconnections = on

# Statistiques
track_activities = on
track_counts = on

# Data directory
data_directory = '/var/lib/postgresql/data'
