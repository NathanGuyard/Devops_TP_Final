#!/bin/bash
# Script de backup PostgreSQL automatique

BACKUP_DIR="/var/backups/postgresql"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG_FILE="/var/log/postgresql/backup.log"

echo "[$(date)] Starting backup..." >> ${LOG_FILE}

# Backup complet
pg_dumpall -U postgres | gzip > "${BACKUP_DIR}/full_backup_${TIMESTAMP}.sql.gz"

if [ $? -eq 0 ]; then
    echo "[$(date)] Backup completed successfully: full_backup_${TIMESTAMP}.sql.gz" >> ${LOG_FILE}
else
    echo "[$(date)] ERROR: Backup failed!" >> ${LOG_FILE}
    exit 1
fi

# Backup de la base applicative
pg_dump -U postgres {{ db_name }} | gzip > "${BACKUP_DIR}/{{ db_name }}_${TIMESTAMP}.sql.gz"

if [ $? -eq 0 ]; then
    echo "[$(date)] Database backup completed: {{ db_name }}_${TIMESTAMP}.sql.gz" >> ${LOG_FILE}
else
    echo "[$(date)] ERROR: Database backup failed!" >> ${LOG_FILE}
fi

# Nettoyage des anciens backups (garder 7 jours)
find ${BACKUP_DIR} -name "*.sql.gz" -mtime +7 -delete
echo "[$(date)] Old backups cleaned up" >> ${LOG_FILE}

echo "[$(date)] Backup process finished" >> ${LOG_FILE}
