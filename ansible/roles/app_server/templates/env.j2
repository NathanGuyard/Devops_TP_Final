# Configuration de l'application
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY={{ lookup('password', '/dev/null length=32 chars=ascii_letters,digits') }}

# Base de données
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_master_ip }}:{{ db_port }}/{{ db_name }}
DATABASE_URL_READ=postgresql://{{ db_user }}:{{ db_password }}@{{ db_slave_ip }}:{{ db_port }}/{{ db_name }}

# Application
APP_NAME={{ app_name }}
APP_PORT={{ app_port }}
LOG_LEVEL=INFO
LOG_FILE=/var/log/app/app.log
HOSTNAME={{ inventory_hostname }}
